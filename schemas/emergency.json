      "title": "《病历书写基本规范》",
      "document_number": "卫医政发〔2010〕11号",
      "issued_date": "2010-01-22",
      "effective_date": "2010-03-01",
      "official_url": "https://www.nhc.gov.cn/yzygj/c100068/201002/766b58f0dd9242d3b62276e5c88d27dc.shtml",
      "scope": "Public national baseline; rule-level clause mappings are identified by source."
    },
    "departmental_template": {
      "source": "illustrative departmental template (synthetic)",
      "scope": "The section selection, labels, order, exact length thresholds, vital-sign encoding, treatment timestamp rule, and disposition vocabulary are fictional evaluation choices and do not reproduce a hospital template."
    }
