  "department": "emergency",
  "display_name": "急诊",
  "sections": [
    {
      "id": "visit_time",
      "label": "就诊时间",
      "required": true,
      "order": 1,
      "rules": [
        {"id": "EM-REQ-001", "type": "required", "source": "《病历书写基本规范》第十三条", "message": "就诊时间不得为空"},
        {"id": "EM-FMT-002", "type": "timestamp_format", "source": "《病历书写基本规范》第九条、第十三条", "message": "就诊时间须使用阿拉伯数字和24小时制并精确到分钟；本示例编码为 YYYY-MM-DD HH:MM"}
      ]
    },
    {
      "id": "chief_complaint",
      "label": "主诉",
      "required": true,
      "order": 2,
      "rules": [
        {"id": "EM-REQ-101", "type": "required", "source": "《病历书写基本规范》第十三条", "message": "主诉不得为空"},
        {"id": "EM-LEN-102", "type": "max_length", "value": 20, "source": "illustrative departmental template (synthetic)", "message": "主诉应在20字以内"},
        {"id": "EM-FMT-103", "type": "must_match", "value": "(天|日|周|月|年|小时|分钟)", "source": "illustrative departmental template (synthetic)", "message": "主诉须包含症状持续时间"},
        {"id": "EM-TERM-104", "type": "must_not_match", "value": "(患者说|病人自述说|据说)", "source": "illustrative departmental template (synthetic)", "message": "主诉应使用规范医学表述，不得转述口语"}
      ]
    },
    {
      "id": "history_present_illness",
      "label": "现病史",
      "required": true,
      "order": 3,
      "rules": [
        {"id": "EM-REQ-201", "type": "required", "source": "《病历书写基本规范》第十三条", "message": "现病史不得为空"},
        {"id": "EM-LEN-202", "type": "min_length", "value": 15, "source": "illustrative departmental template (synthetic)", "message": "现病史应记录症状发生和变化"}
      ]
    },
    {
      "id": "allergy_history",
      "label": "过敏史",
      "required": true,
      "order": 4,
      "rules": [
        {"id": "EM-REQ-301", "type": "required", "source": "《病历书写基本规范》第十二条", "message": "药物过敏史不得为空"}
      ]
    },
    {
      "id": "vital_signs",
      "label": "生命体征",
      "required": true,
      "order": 5,
      "rules": [
        {"id": "EM-REQ-401", "type": "required", "source": "illustrative departmental template (synthetic)", "message": "生命体征不得为空"},
        {"id": "EM-FMT-402", "type": "numeric_fields", "value": ["T", "P", "R", "BP", "SpO2"], "source": "illustrative departmental template (synthetic)", "message": "生命体征必须逐项使用字面字段标签 T、P、R、BP、SpO2 记录对应数值"}
      ]
    },
    {
      "id": "physical_exam",
      "label": "体格检查",
      "required": true,
      "order": 6,
      "rules": [
        {"id": "EM-REQ-501", "type": "required", "source": "《病历书写基本规范》第十三条", "message": "阳性体征和必要的阴性体征不得为空"}
      ]
    },
    {
      "id": "ancillary_exam",
      "label": "辅助检查",
      "required": false,
      "order": 7,
      "rules": []
    },
    {
      "id": "initial_diagnosis",
      "label": "初步诊断",
      "required": true,
      "order": 8,
      "rules": [
        {"id": "EM-REQ-601", "type": "required", "source": "《病历书写基本规范》第十三条", "message": "诊断不得为空"}
      ]
    },
    {
      "id": "emergency_treatment",
      "label": "急诊处置",
      "required": true,
      "order": 9,
      "rules": [
        {"id": "EM-REQ-701", "type": "required", "source": "《病历书写基本规范》第十三条", "message": "治疗处理意见不得为空"},
        {"id": "EM-FMT-702", "type": "must_match", "value": "\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}", "source": "illustrative departmental template (synthetic)", "message": "急诊处置须至少包含一个 YYYY-MM-DD HH:MM 时间戳"}
      ]
    },
    {
      "id": "disposition",
      "label": "去向",
      "required": true,
      "order": 10,
      "rules": [
        {"id": "EM-REQ-801", "type": "required", "source": "《病历书写基本规范》第十五条", "message": "急诊留观记录应注明患者去向"},
        {"id": "EM-FMT-802", "type": "must_match", "value": "^(留观|收入院|离院|转院)$", "source": "illustrative departmental template (synthetic)", "message": "本示例的去向须为留观、收入院、离院或转院之一"}
      ]
    }
  ],
  "global_rules": [
    {"id": "EM-ORD-900", "type": "section_order", "source": "illustrative departmental template (synthetic)", "message": "章节顺序须符合示例科室模板"}
  ]
}
